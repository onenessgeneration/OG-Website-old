# ─────────────────────────────────────────────────────────────
# Supabase configuration
# ─────────────────────────────────────────────────────────────
# Get these values from your Supabase project:
#   Project Settings → API
#
# The VITE_ prefixed variables are exposed to the browser bundle
# (safe: publishable/anon key only). The unprefixed variables are
# used by server functions during SSR.
# ─────────────────────────────────────────────────────────────

# Client-side (browser)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side (SSR / server functions). Same values as above.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# SERVER ONLY — never expose to the browser, never prefix with VITE_.
# Required for privileged admin operations (Auth Admin API, role grants,
# webhook writes). Get from Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
